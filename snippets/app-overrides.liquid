{%- doc -%}
  Theme-side overrides for third-party app widgets that don't expose their
  own styling/placement controls. Kept separate from theme.liquid so it's
  easy to find and adjust as apps update their markup.
{%- enddoc -%}

{% style %}
  /* Badge/feature rows (3+ icon+text items in a row, e.g. trust badges in
     the footer and on the product page) — let items wrap onto a new line
     instead of being squeezed until the text breaks mid-word. */
  .layout-panel-flex--row:has(> .group-block:nth-child(3)) {
    flex-wrap: wrap !important;
    row-gap: 12px !important;
  }

  /* Product cards (collection/homepage grids): a soft shadow instead of a
     hard outline gives them separation from the page background without
     looking like a boxed-in frame around each product. */
  .product-card {
    box-shadow: 0 1px 2px rgba(30, 24, 12, 0.04), 0 4px 12px rgba(30, 24, 12, 0.06);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover {
    box-shadow: 0 2px 4px rgba(30, 24, 12, 0.05), 0 8px 20px rgba(30, 24, 12, 0.09);
    transform: translateY(-2px);
  }

  /* Product card titles: clamp to 2 lines so cards with longer product
     names don't push their price/button lower than the rest of the row. */
  product-card [class*="product_title"] {
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    height: 2lh !important;
  }

  /* Footer utilities row (copyright + policy links): stack copyright on top
     of the policy links, centered, instead of side-by-side — the copyright
     text wraps to two lines on its own while the links stay on one line,
     which looked lopsided in a side-by-side grid. */
  .utilities {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    gap: 8px !important;
  }

  .utilities > * {
    justify-self: center !important;
    text-align: center !important;
  }

  .policy_list--inline {
    justify-content: center !important;
  }

  /* On narrow screens, wrapped-and-centered policy links produce ragged,
     uneven line lengths. A single centered column reads as tidy instead. */
  @media screen and (max-width: 749px) {
    .policy_list--inline {
      flex-direction: column !important;
      align-items: center !important;
      gap: 10px !important;
    }
  }

{% endstyle %}
